# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# =========================
# IDEs y editores
# =========================
.idea/
*.iml
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# VSCode (se guarda la config compartida, se ignora el estado personal)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# =========================
# Claude Code local settings
# =========================
.claude/settings.local.json*
