# =========================
# Dependencies
# =========================
node_modules/
.pnp
.pnp.js
.pnp.cjs

# =========================
# Build output
# =========================
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# =========================
# Variables de entorno
# =========================
# .env.example es la única plantilla versionada — el resto son valores
# reales de cada máquina/ambiente (algunos con contraseñas de demo, ver
# .env.example), nunca se suben.
.env
.env.*
!.env.example
!.env.*.example
# Convención de Vite: cualquier archivo "*.local" es siempre personal de
# la máquina, incluso si no matchea los patrones de arriba.
*.local

# =========================
# Testing & coverage
# =========================
/coverage
/.nyc_output

# =========================
# Logs
# =========================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================
# Archivos temporales sueltos
# (convención usada en este repo para scripts de verificación
# descartables: *.tmp.ts, *.tmp.tsx)
# =========================
*.tmp.ts
*.tmp.tsx
*.tmp
*.bak
*.orig
*.rej
.temp
.tmp
.cache
.eslintcache
.pnpm-store/

# =========================
# Certificados TLS de docker/ssl/ ("make ssl-generate" los recrea)
# =========================
docker/ssl/*.pem
docker/ssl/*.key
docker/ssl/*.crt
!docker/ssl/README.md

# =========================
# OS files
# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
ehthumbs.db
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.directory

# =========================
# IDEs y editores
# =========================
.idea/
*.iml
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project
# Extensión "Local History" de VSCode y similares.
.history/

# VSCode (se guarda la config compartida, se ignora el estado personal)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# =========================
# Claude Code local settings
# =========================
.claude/settings.local.json*
