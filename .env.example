# Dos plantillas de uso según cómo corras el proyecto:
#   - Local sin Docker: copiá esto a ".env.local" — Vite lo carga
#     automático y queda fuera de git (ver .gitignore). "pnpm dev" ya
#     funciona así.
#   - Con Docker: "make env-setup" copia esto a ".env.dev" y ".env.prod".
#     docker-compose los inyecta como variables del contenedor; llegan a
#     import.meta.env porque Vite también expone las variables de
#     process.env que empiezan con "VITE_", no solo las de archivo.

# URL de la API de iCode-back.
# OJO en producción: Vite "hornea" VITE_API_URL en el bundle en BUILD TIME,
# no en runtime (a diferencia de las env vars del backend) — en Docker
# viaja como build arg (ver docker-compose.prod.yml), así que cambiarla
# después de compilar exige un rebuild de la imagen, no solo reiniciar el
# contenedor.
VITE_API_URL=http://localhost:3000

# Backend simulado: con "1", ningún request sale a la red — los responde
# src/infrastructure/http/mock (usuarios fijos, ver README). Sirve para
# trabajar el front sin iCode-back levantado.
#
# Queda COMENTADA a propósito: "make env-setup" copia este archivo a
# .env.prod, y un build de producción con la flag prendida se autenticaría
# solo contra usuarios inventados. Descomentala únicamente en .env.local.
# VITE_USE_MOCK_DATA=1

# Modo prototipo: con estas dos variables la app abre sesión sola al
# arrancar y no pide usuario ni contraseña (útil para demos). No es un
# bypass: hace el mismo POST /auth/login que el formulario, con estas
# credenciales fijas. Si están vacías o ausentes, login normal.
#
# COMENTADAS a propósito, y esta vez importa de verdad: Vite hornea el valor
# en el bundle en BUILD TIME, así que un build con esto puesto publica una
# contraseña en el JavaScript y entra solo. Nunca en .env.prod — solo en
# .env.local, y solo con VITE_USE_MOCK_DATA=1.
# VITE_DEMO_USER=admin
# VITE_DEMO_PASSWORD=Passw0rd1!
