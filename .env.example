# Dos plantillas de uso según cómo corras el proyecto:
#   - Local sin Docker: copiá esto a ".env.local" — Vite lo carga
#     automático y queda fuera de git (ver .gitignore). "pnpm dev" ya
#     funciona así.
#   - Con Docker: "make env-setup" copia esto a ".env.dev" y ".env.prod".
#     docker-compose los inyecta como variables del contenedor; llegan a
#     import.meta.env porque Vite también expone las variables de
#     process.env que empiezan con "VITE_", no solo las de archivo.

# URL de la API de iCode-back.
# OJO en producción: Vite "hornea" VITE_API_URL en el bundle en BUILD TIME,
# no en runtime (a diferencia de las env vars del backend) — en Docker
# viaja como build arg (ver docker-compose.prod.yml), así que cambiarla
# después de compilar exige un rebuild de la imagen, no solo reiniciar el
# contenedor.
VITE_API_URL=http://localhost:3000
